{
  "name": "danta-workbench-ui",
  "version": "0.2.0",
  "description": "面向龚博士的本机科研工作台桌面应用。",
  "author": "Danta Research Workbench",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "start": "vite --host 127.0.0.1 --strictPort --open",
    "build": "vite build",
    "build:desktop": "node desktop/build.js",
    "dist:win": "npm run build:desktop && electron-builder --win nsis --x64",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run build"
  },
  "devDependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  },
  "build": {
    "appId": "org.danta.research-workbench",
    "productName": "龚博士科研工作台",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/main.js",
      "desktop/assets/danta-workbench.ico",
      "desktop/assets/danta-workbench.png",
      "server/localBridge.js",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "desktop/assets/danta-workbench.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Danta-Research-Workbench-${version}-x64-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "龚博士科研工作台",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
